{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "food-agent/evals/expert-signoff-v1",
  "title": "Phase 2 hash-bound dual-expert signoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rubric_version", "dataset_hash", "code_eval_hash", "reviews", "judge_scores"],
  "properties": {
    "schema_version": {"const": "expert-signoff.v1"},
    "rubric_version": {"const": "phase02-rubric.v1"},
    "dataset_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "code_eval_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviews": {
      "type": "array",
      "minItems": 48,
      "items": {"$ref": "#/$defs/review"}
    },
    "judge_scores": {
      "type": "array",
      "items": {"$ref": "#/$defs/judgeScore"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "role": {"enum": ["nutritionist", "food_composition_data_steward", "product", "privacy"]},
    "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "role", "pseudonym", "rubric_version", "dataset_hash", "code_eval_hash", "confirmations"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^phase02-[0-9]{3}$"},
        "role": {"$ref": "#/$defs/role"},
        "pseudonym": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$"},
        "rubric_version": {"const": "phase02-rubric.v1"},
        "dataset_hash": {"$ref": "#/$defs/hash"},
        "code_eval_hash": {"$ref": "#/$defs/hash"},
        "confirmations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["food_code", "blocking_fields", "household_portion_auditability", "authoritative_values", "hard_validation"],
          "properties": {
            "food_code": {"type": "boolean"},
            "blocking_fields": {"type": "boolean"},
            "household_portion_auditability": {"type": "boolean"},
            "authoritative_values": {"type": "boolean"},
            "hard_validation": {"type": "boolean"}
          }
        },
        "medium_human_score": {"$ref": "#/$defs/score"}
      }
    },
    "judgeScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "rubric_version", "dataset_hash", "code_eval_hash", "score"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^phase02-[0-9]{3}$"},
        "rubric_version": {"const": "phase02-rubric.v1"},
        "dataset_hash": {"$ref": "#/$defs/hash"},
        "code_eval_hash": {"$ref": "#/$defs/hash"},
        "score": {"$ref": "#/$defs/score"}
      }
    }
  }
}
