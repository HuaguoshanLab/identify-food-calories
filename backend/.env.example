# Local values are intentionally development-only. Copy this file to `.env`.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/food_agent_dev
SECRET_KEY=local-development-secret-not-for-production
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# Local email is captured by Mailpit; no cloud credentials are needed.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@local.test
SMTP_USERNAME=
SMTP_PASSWORD=

# Tests must override APP_ENV=test and DATABASE_URL with this dedicated database.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/food_agent_test

# Production must override every secret/email value, enable Secure cookies, and
# provide explicit HTTPS CORS origins. Startup rejects these local defaults.

# Production-only DeepSeek configuration. The API key and current price snapshot
# are server secrets/operations data and must never be committed in `.env`.
REASONING_PROVIDER_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRICE_SNAPSHOT_VERSION=
DEEPSEEK_INPUT_USD_PER_M=
DEEPSEEK_OUTPUT_USD_PER_M=

# Telemetry is disabled by default. Production exports only allowlisted metrics to
# this explicit collector; it never starts a local Phoenix UI or exports meal text.
TRACING_ENABLED=false
TRACING_COLLECTOR_ENDPOINT=
TRACING_HMAC_KEY=
TRACING_SERVICE_NAME=food-agent
TRACING_SERVICE_VERSION=

# D-18 retention is explicit in production: saver/events are retained 7 days,
# minimal ledger metadata 30 days, and queued user deletion is claimed before 24h.
RETENTION_CHECKPOINT_EVENT_DAYS=7
RETENTION_AUDIT_DAYS=30
RETENTION_DELETION_SLA_HOURS=24
RETENTION_POLL_INTERVAL_SECONDS=300

# Images are normalized into this private, non-public temporary directory. Production
# must set each value explicitly; images never belong in the database or public uploads.
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=20000000
IMAGE_TEMPORARY_DIRECTORY=/var/lib/food-agent/tmp-images
IMAGE_TTL_SECONDS=300

# Vision calls are disabled locally by default and forced to Fake in tests. A production
# deployment must verify the selected Qwen region/scope before supplying these secrets.
VISION_PROVIDER_MODE=fake
QWEN_API_KEY=
QWEN_MODEL=
QWEN_REGION=
QWEN_DEPLOYMENT_SCOPE=
QWEN_BASE_URL=
QWEN_PRICE_SNAPSHOT_VERSION=
QWEN_INPUT_USD_PER_M=
QWEN_OUTPUT_USD_PER_M=
VISION_TIMEOUT_SECONDS=20
VISION_MAX_PIXELS=20000000
