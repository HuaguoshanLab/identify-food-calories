# Local-only runtime configuration. This file is intentionally ignored by Git.
# Values copied from the Model Studio business-space page. The API key, model and
# price snapshot remain intentionally unset until they are selected and verified.
VISION_PROVIDER_MODE=qwen
QWEN_REGION=cn-beijing
QWEN_DEPLOYMENT_SCOPE=默认业务空间
QWEN_BASE_URL=https://llm-0ukt6fomp8qyraqo.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VISION_TIMEOUT_SECONDS=20
VISION_MAX_PIXELS=20000000
QWEN_API_KEY=
QWEN_MODEL=qwen3-vl-flash
QWEN_PRICE_SNAPSHOT_VERSION=model-studio-2026-08-31
QWEN_UP_TO_32K_INPUT_CNY_PER_M=0.15
QWEN_UP_TO_32K_OUTPUT_CNY_PER_M=1.5
QWEN_UP_TO_128K_INPUT_CNY_PER_M=0.3
QWEN_UP_TO_128K_OUTPUT_CNY_PER_M=3
QWEN_UP_TO_256K_INPUT_CNY_PER_M=0.6
QWEN_UP_TO_256K_OUTPUT_CNY_PER_M=6
APP_ENV=local
# 管理员密码Set this in each computer's ignored backend/.env; it is intentionally not stored here.
LOCAL_BOOTSTRAP_ADMIN_PASSWORD=

REASONING_PROVIDER_MODE=deepseek
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/food_agent_dev
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@local.test
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5178","http://127.0.0.1:5178","http://localhost:5179","http://127.0.0.1:5179"]


DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRICE_SNAPSHOT_VERSION=2026-08-29-deepseek-v4-flash-standard
DEEPSEEK_INPUT_USD_PER_M=0.14
DEEPSEEK_OUTPUT_USD_PER_M=0.28
PILOT_USD_TO_CNY_CEILING=8.0

# DashScope embedding is a controlled catalog-only provider.  Keep the key only
# in ignored backend/.env; requests cannot choose an endpoint, model, or dimension.
EMBEDDING_PROVIDER_MODE=dashscope
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_ADAPTER_VERSION=dashscope-text-embedding-v4-1024.v1
EMBEDDING_PRICE_SNAPSHOT_VERSION=dashscope-2026-09-10
EMBEDDING_INPUT_CNY_PER_M=0.5
EMBEDDING_SINGLE_CALL_CAP_CNY=0.01
EMBEDDING_PERIOD_CAP_CNY=20
EMBEDDING_TIMEOUT_SECONDS=1.5
# A single lifespan-owned worker checks for durable PostgreSQL jobs at this cadence.
EMBEDDING_WORKER_POLL_INTERVAL_SECONDS=5

TRACING_ENABLED=true
TRACING_BACKEND=langfuse
TRACING_HMAC_KEY=
TRACING_SERVICE_NAME=food-agent-backend
TRACING_SERVICE_VERSION=local-dev
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3001


# MEM0
MEMORY_PROVIDER_MODE=mem0
MEM0_API_KEY=
MEM0_ENDPOINT=https://api.mem0.ai
