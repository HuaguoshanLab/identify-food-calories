{
  "components": {
    "schemas": {
      "AgentCommandAcceptedResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AgentThreadStatus"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "status"
        ],
        "title": "AgentCommandAcceptedResponse",
        "type": "object"
      },
      "AgentDeletionAcceptedResponse": {
        "additionalProperties": false,
        "properties": {
          "due_at": {
            "format": "date-time",
            "title": "Due At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AgentThreadStatus",
            "default": "deletion_pending"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "due_at"
        ],
        "title": "AgentDeletionAcceptedResponse",
        "type": "object"
      },
      "AgentErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "AgentErrorDetail",
        "type": "object"
      },
      "AgentErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/AgentErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "AgentErrorResponse",
        "type": "object"
      },
      "AgentImageAcceptedResponse": {
        "additionalProperties": false,
        "description": "Public upload result exposes only opaque IDs and lifecycle state.",
        "properties": {
          "image_id": {
            "format": "uuid",
            "title": "Image Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AgentThreadStatus"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "status",
          "image_id"
        ],
        "title": "AgentImageAcceptedResponse",
        "type": "object"
      },
      "AgentInputKind": {
        "enum": [
          "description"
        ],
        "title": "AgentInputKind",
        "type": "string"
      },
      "AgentInputRequest": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/AgentInputKind"
          },
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "title": "AgentInputRequest",
        "type": "object"
      },
      "AgentThreadCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "input_text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Input Text",
            "type": "string"
          }
        },
        "required": [
          "input_text"
        ],
        "title": "AgentThreadCreateRequest",
        "type": "object"
      },
      "AgentThreadSnapshot": {
        "additionalProperties": false,
        "description": "Safe, implementation-independent thread shape reserved for future GREEN.",
        "properties": {
          "report": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report"
          },
          "revision": {
            "minimum": 0,
            "title": "Revision",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/AgentThreadStatus"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "status",
          "revision"
        ],
        "title": "AgentThreadSnapshot",
        "type": "object"
      },
      "AgentThreadStatus": {
        "description": "All lifecycle states that browser clients must handle from day one.",
        "enum": [
          "waiting",
          "partial",
          "completed",
          "retryable",
          "terminal",
          "deletion_pending"
        ],
        "title": "AgentThreadStatus",
        "type": "string"
      },
      "Body_uploadAgentMealImage": {
        "properties": {
          "image": {
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "type": "string"
          }
        },
        "required": [
          "image"
        ],
        "title": "Body_uploadAgentMealImage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Food Agent API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
