{
  "components": {
    "schemas": {
      "ActivityLevel": {
        "description": "The only five activity inputs accepted by target-policy.v1.",
        "enum": [
          "sedentary",
          "light",
          "moderate",
          "high",
          "very_high"
        ],
        "title": "ActivityLevel",
        "type": "string"
      },
      "AgentCommandAcceptedResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AgentThreadStatus"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "status"
        ],
        "title": "AgentCommandAcceptedResponse",
        "type": "object"
      },
      "AgentDeletionAcceptedResponse": {
        "additionalProperties": false,
        "properties": {
          "due_at": {
            "format": "date-time",
            "title": "Due At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AgentThreadStatus",
            "default": "deletion_pending"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "due_at"
        ],
        "title": "AgentDeletionAcceptedResponse",
        "type": "object"
      },
      "AgentErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "AgentErrorDetail",
        "type": "object"
      },
      "AgentErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/AgentErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "AgentErrorResponse",
        "type": "object"
      },
      "AgentImageAcceptedResponse": {
        "additionalProperties": false,
        "description": "Public upload result exposes only opaque IDs and lifecycle state.",
        "properties": {
          "image_id": {
            "format": "uuid",
            "title": "Image Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AgentThreadStatus"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "status",
          "image_id"
        ],
        "title": "AgentImageAcceptedResponse",
        "type": "object"
      },
      "AgentInputKind": {
        "enum": [
          "description"
        ],
        "title": "AgentInputKind",
        "type": "string"
      },
      "AgentInputRequest": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/AgentInputKind"
          },
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "title": "AgentInputRequest",
        "type": "object"
      },
      "AgentThreadCreateRequest": {
        "additionalProperties": false,
        "properties": {
          "input_text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Input Text",
            "type": "string"
          }
        },
        "required": [
          "input_text"
        ],
        "title": "AgentThreadCreateRequest",
        "type": "object"
      },
      "AgentThreadSnapshot": {
        "additionalProperties": false,
        "description": "Safe, implementation-independent thread shape reserved for future GREEN.",
        "properties": {
          "recovery_code": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recovery Code"
          },
          "report": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report"
          },
          "revision": {
            "minimum": 0,
            "title": "Revision",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/AgentThreadStatus"
          },
          "thread_id": {
            "format": "uuid",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "status",
          "revision"
        ],
        "title": "AgentThreadSnapshot",
        "type": "object"
      },
      "AgentThreadStatus": {
        "description": "All lifecycle states that browser clients must handle from day one.",
        "enum": [
          "waiting",
          "partial",
          "completed",
          "retryable",
          "terminal",
          "deletion_pending"
        ],
        "title": "AgentThreadStatus",
        "type": "string"
      },
      "Body_uploadAgentMealImage": {
        "properties": {
          "image": {
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "type": "string"
          }
        },
        "required": [
          "image"
        ],
        "title": "Body_uploadAgentMealImage",
        "type": "object"
      },
      "DietPlanningStartCommand": {
        "additionalProperties": false,
        "description": "The complete transient input for a new plan; profiles are never inferred by a model.",
        "properties": {
          "preferences": {
            "$ref": "#/components/schemas/PreferenceReview"
          },
          "profile": {
            "$ref": "#/components/schemas/PlanningProfileInput"
          },
          "save_profile": {
            "default": false,
            "title": "Save Profile",
            "type": "boolean"
          }
        },
        "required": [
          "profile",
          "preferences"
        ],
        "title": "DietPlanningStartCommand",
        "type": "object"
      },
      "FormulaVariant": {
        "description": "Explicit calculation variant; this field is never inferred from user data.",
        "enum": [
          "mifflin_st_jeor_male",
          "mifflin_st_jeor_female"
        ],
        "title": "FormulaVariant",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PlanningGoal": {
        "enum": [
          "maintain",
          "loss",
          "gain"
        ],
        "title": "PlanningGoal",
        "type": "string"
      },
      "PlanningProfileInput": {
        "additionalProperties": false,
        "description": "Transient profile data. Optional fields allow a safe NEEDS_INPUT response.",
        "properties": {
          "activity_level": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActivityLevel"
              },
              {
                "type": "null"
              }
            ]
          },
          "age_years": {
            "anyOf": [
              {
                "maximum": 130,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Years"
          },
          "formula_variant": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FormulaVariant"
              },
              {
                "type": "null"
              }
            ]
          },
          "goal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanningGoal"
              },
              {
                "type": "null"
              }
            ]
          },
          "goal_speed": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal Speed"
          },
          "has_disease_or_treatment": {
            "default": false,
            "title": "Has Disease Or Treatment",
            "type": "boolean"
          },
          "has_eating_disorder_or_self_harm_risk": {
            "default": false,
            "title": "Has Eating Disorder Or Self Harm Risk",
            "type": "boolean"
          },
          "has_extreme_weight_control_goal": {
            "default": false,
            "title": "Has Extreme Weight Control Goal",
            "type": "boolean"
          },
          "height_cm": {
            "anyOf": [
              {
                "maximum": 250,
                "minimum": 100,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Cm"
          },
          "is_pregnant_or_breastfeeding": {
            "default": false,
            "title": "Is Pregnant Or Breastfeeding",
            "type": "boolean"
          },
          "uses_medication": {
            "default": false,
            "title": "Uses Medication",
            "type": "boolean"
          },
          "weight_kg": {
            "anyOf": [
              {
                "maximum": 350,
                "minimum": 20,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Kg"
          }
        },
        "title": "PlanningProfileInput",
        "type": "object"
      },
      "PreferenceReview": {
        "additionalProperties": false,
        "description": "Planning may only use preferences after the user has explicitly reviewed them.",
        "properties": {
          "confirmed": {
            "title": "Confirmed",
            "type": "boolean"
          },
          "exclusions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Exclusions",
            "type": "array"
          },
          "taste_preferences": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Taste Preferences",
            "type": "array"
          }
        },
        "required": [
          "confirmed"
        ],
        "title": "PreferenceReview",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Food Agent API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/agent/threads": {
      "post": {
        "operationId": "createAgentThread",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentThreadCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentThreadSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Bearer authentication failed."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Thread is unavailable."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Command conflicts."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Agent Thread",
        "tags": [
          "agent"
        ]
      }
    },
    "/api/v1/agent/threads/diet-planning": {
      "post": {
        "description": "Start one owned planning thread; the key deterministically reuses its ledger command.",
        "operationId": "createDietPlanningThread",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DietPlanningStartCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentThreadSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Bearer authentication failed."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Thread is unavailable."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Command conflicts."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Diet Planning Thread",
        "tags": [
          "agent"
        ]
      }
    },
    "/api/v1/agent/threads/image": {
      "post": {
        "description": "Create an owned empty thread so image upload never needs a fabricated text command.",
        "operationId": "createAgentImageThread",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentThreadSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Bearer authentication failed."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Thread is unavailable."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Command conflicts."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Agent Image Thread",
        "tags": [
          "agent"
        ]
      }
    },
    "/api/v1/agent/threads/{thread_id}": {
      "delete": {
        "description": "Persist the bounded deletion deadline before waking the lifespan-owned worker.",
        "operationId": "deleteAgentThread",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Thread Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentDeletionAcceptedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Bearer authentication failed."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Thread is unavailable."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Command conflicts."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Agent Thread",
        "tags": [
          "agent"
        ]
      },
      "get": {
        "operationId": "getAgentThread",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Thread Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentThreadSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Bearer authentication failed."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Thread is unavailable."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Command conflicts."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Agent Thread",
        "tags": [
          "agent"
        ]
      }
    },
    "/api/v1/agent/threads/{thread_id}/events": {
      "get": {
        "operationId": "streamAgentEvents",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Thread Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Server-sent Agent events."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Bearer authentication failed."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Thread is unavailable."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Command conflicts."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Stream Agent Events",
        "tags": [
          "agent"
        ]
      }
    },
    "/api/v1/agent/threads/{thread_id}/images": {
      "post": {
        "description": "Validate a bounded multipart image after ownership, then erase its temporary handle.",
        "operationId": "uploadAgentMealImage",
        "parameters": [
          {
            "in": "path",
            "name": "thread_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Thread Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_uploadAgentMealImage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentImageAcceptedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Bearer authentication failed."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Thread is unavailable."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description": "Command conflicts."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Upload Agent Meal Image",
        "tags": [
          "agent"
        ]
      }
    },
    "/api/v1/agent/threads/{thread_id}/input": {
      "post": {
        "operationId": "submitAgentInput",
        "parameters": [
          {
            "in": "path",
