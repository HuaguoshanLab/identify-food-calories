# Copy to .env.langfuse and replace every infrastructure placeholder.
# Use `openssl rand -base64 32`; ENCRYPTION_KEY uses `openssl rand -hex 32`.
LANGFUSE_POSTGRES_PASSWORD=replace-with-local-random-password
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-local-random-password
LANGFUSE_REDIS_PASSWORD=replace-with-local-random-password
LANGFUSE_MINIO_ROOT_PASSWORD=replace-with-local-random-password
LANGFUSE_NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
LANGFUSE_SALT=replace-with-at-least-32-random-characters
LANGFUSE_ENCRYPTION_KEY=replace-with-exactly-64-hex-characters

# After creating the food-agent-dev project in http://127.0.0.1:3001, paste
# Project Settings -> API Keys here. Compose itself does not create project keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3001
