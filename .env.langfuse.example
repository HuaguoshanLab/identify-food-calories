# Copy to .env.langfuse (ignored), replace every value, then start only the
# optional local experiment mirror. These are not application credentials.
LANGFUSE_POSTGRES_PASSWORD=replace-with-a-local-random-password
LANGFUSE_NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
LANGFUSE_SALT=replace-with-at-least-32-random-characters
LANGFUSE_MINIO_ROOT_PASSWORD=replace-with-a-local-random-password
LANGFUSE_PUBLIC_KEY=pk-lf-local-replace-me
LANGFUSE_SECRET_KEY=sk-lf-local-replace-me
